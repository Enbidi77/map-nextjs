{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@modern-maps/types": ["../types/src/index.ts"],
      "@modern-maps/geospatial": ["../geospatial/src/index.ts"],
      "@modern-maps/validation": ["../validation/src/index.ts"],
      "@modern-maps/supabase": ["../supabase/src/index.ts"],
      "@modern-maps/map-data": ["../map-data/src/index.ts"]
    }
  }
}
