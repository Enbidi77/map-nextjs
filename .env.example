# ==============================================================================
# Modern Maps & Location Intelligence Platform - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Server
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Supabase Integration (Backend-as-a-Service)
# ------------------------------------------------------------------------------
# Public Supabase credentials for client-side and SSR authentication
# When using Supabase CLI locally, run `supabase start` to get these defaults:
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A_dummy_anon_key_for_local_dev
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A_dummy_anon_key_for_local_dev

# Supabase Admin / Service Role Key
# CRITICAL: Keep this strictly server-side. NEVER expose to client bundles!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.dummy_service_role_key_for_local_dev

# Supabase Local & Cloud Project Configuration
SUPABASE_PROJECT_ID=modern-maps-local
SUPABASE_DB_PASSWORD=postgres
SUPABASE_ACCESS_TOKEN=

# ------------------------------------------------------------------------------
# 3. PostGIS Database & Storage
# ------------------------------------------------------------------------------
# Direct Postgres connection string (for migrations, seed, and server connection pools)
# For Supabase local CLI: port is typically 54322. For standalone Docker: port is 5432.
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_PORT=54322

# Supabase Storage Buckets
NEXT_PUBLIC_STORAGE_BUCKET_PLACES=place-photos
NEXT_PUBLIC_STORAGE_BUCKET_COVERS=collection-covers
NEXT_PUBLIC_STORAGE_BUCKET_GEOJSON=geojson-imports
NEXT_PUBLIC_STORAGE_BUCKET_ATTACHMENTS=map-attachments

# ------------------------------------------------------------------------------
# 4. Cache & Realtime PubSub (Redis)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 5. Map & Geospatial Defaults
# ------------------------------------------------------------------------------
NEXT_PUBLIC_MAP_DEFAULT_STYLE=streets
NEXT_PUBLIC_MAP_CENTER_LNG=-122.4194
NEXT_PUBLIC_MAP_CENTER_LAT=37.7749
NEXT_PUBLIC_MAP_DEFAULT_ZOOM=12

# Standard Basemap Tile Styles (Carto, OpenStreetMap, MapLibre styles)
NEXT_PUBLIC_CARTO_POSITRON_STYLE=https://basemaps.cartocdn.com/gl/positron-gl-style/style.json
NEXT_PUBLIC_CARTO_DARK_MATTER_STYLE=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json
NEXT_PUBLIC_CARTO_VOYAGER_STYLE=https://basemaps.cartocdn.com/gl/voyager-gl-style/style.json
NEXT_PUBLIC_OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# ------------------------------------------------------------------------------
# 6. Geospatial Services & API Keys (Optional 3rd party providers)
# ------------------------------------------------------------------------------
MAPTILER_API_KEY=
STADIA_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=
OPENROUTESERVICE_API_KEY=

# Routing & Geocoding Providers:
# Options: supabase-edge | nominatim | maptiler | mapbox | osrm | openrouteservice
NEXT_PUBLIC_GEOCODING_PROVIDER=supabase-edge
NEXT_PUBLIC_DIRECTIONS_PROVIDER=supabase-edge
