# Modern Maps Platform Environment Configuration

# Application
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (PostGIS)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/modern_maps
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=modern_maps
POSTGRES_PORT=5432

# Cache & PubSub (Redis)
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# Map & Geospatial Services
NEXT_PUBLIC_MAP_DEFAULT_STYLE=streets
NEXT_PUBLIC_MAP_CENTER_LNG=-122.4194
NEXT_PUBLIC_MAP_CENTER_LAT=37.7749
NEXT_PUBLIC_MAP_DEFAULT_ZOOM=12

# Optional 3rd party tile / geocoding API keys
MAPTILER_API_KEY=
STADIA_MAPS_API_KEY=
